# =============================================================================
# Megicula Stake - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Blockchain / Deployment
# -----------------------------------------------------------------------------

# Private key of the deployer wallet (without 0x prefix is also accepted)
# WARNING: Never commit your real private key to version control!
PRIVATE_KEY=

# OPN Testnet RPC endpoint
OPN_TESTNET_RPC=https://testnet-rpc.iopn.tech

# Etherscan API key for contract verification (optional)
ETHERSCAN_API_KEY=

# -----------------------------------------------------------------------------
# Frontend (Next.js)
# -----------------------------------------------------------------------------

# Chain ID for OPN Testnet
NEXT_PUBLIC_CHAIN_ID=984

# RPC URL for frontend wallet connection
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.iopn.tech

# WalletConnect Project ID (get one at https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------

# Enable gas reporting in tests
REPORT_GAS=false
